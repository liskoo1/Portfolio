{
  "name": "mi-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:css": "sass sass/app.scss sass/style.css --style=expanded --no-source-map",
    "watch:css": "sass --watch sass/app.scss sass/style.css --style=expanded --no-source-map",
    "optimize:images": "node scripts/optimize-images.mjs",
    "predev": "npm run build:css",
    "prebuild": "npm run build:css"
  },
  "devDependencies": {
    "sass": "^1.80.5",
    "sharp": "^0.35.3",
    "vite": "^5.2.0"
  }
}
