{
  "name": "mi-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:css": "sass sass/app.scss sass/style.css --style=expanded --no-source-map",
    "watch:css": "sass --watch sass/app.scss sass/style.css --style=expanded --no-source-map",
    "optimize:images": "node scripts/optimize-images.mjs",
    "predev": "npm run build:css",
    "prebuild": "npm run build:css",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "sass": "^1.80.5",
    "sharp": "^0.35.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "three": "^0.134.0",
    "vanta": "^0.5.24"
  }
}
